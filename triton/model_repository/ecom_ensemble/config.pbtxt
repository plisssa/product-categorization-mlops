name: "ecom_ensemble"
platform: "ensemble"
max_batch_size: 8
input [ { name: "TEXT" data_type: TYPE_STRING dims: [ 1 ] } ]
output [ { name: "CATEGORY_IND" data_type: TYPE_INT64 dims: [ 1 ] } ]
ensemble_scheduling {
  step [
    {
      model_name: "preprocess"
      model_version: -1
      input_map  { key: "TEXT" value: "TEXT" }
      output_map { key: "INPUT_IDS" value: "ids" }
      output_map { key: "ATTENTION_MASK" value: "mask" }
    },
    {
      model_name: "text_encoder"
      model_version: -1
      input_map  { key: "INPUT_IDS" value: "ids" }
      input_map  { key: "ATTENTION_MASK" value: "mask" }
      output_map { key: "EMBEDDING" value: "emb" }
    },
    {
      model_name: "category_head"
      model_version: -1
      input_map  { key: "EMBEDDING" value: "emb" }
      output_map { key: "PROBS" value: "probs" }
    },
    {
      model_name: "postprocess"
      model_version: -1
      input_map  { key: "PROBS" value: "probs" }
      output_map { key: "CATEGORY_IND" value: "CATEGORY_IND" }
    }
  ]
}
