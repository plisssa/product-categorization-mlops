# ---- Service ----
SERVICE_PORT=8080
MODEL_BACKEND=triton            # triton | local
TRITON_URL=triton:8000
LOCAL_MODEL_PATH=artifacts/serving/model.joblib
# Запасной источник весов, если креды S3 не заданы (ассет релиза)
MODEL_PUBLIC_URL=https://github.com/plisssa/product-categorization-mlops/releases/download/v1.0/model.joblib
REQUEST_TIMEOUT=10
IMAGE_DOWNLOAD_TIMEOUT=5

# ---- Cache (Redis) ----
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=86400

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=ecom-category

# ---- S3 / MinIO (get keys at https://console.minio.v-efimov.tech) ----
MLFLOW_S3_ENDPOINT_URL=https://minio.v-efimov.tech
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
S3_BUCKET=e.puzyreva
S3_ARTIFACTS_PREFIX=models

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
